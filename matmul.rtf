\f0\fs24 \cf0 #include <stdio.h>\
#include <stdlib.h>\
#include <time.h>\
#define N 1024\
\
    // ======================================================\
    // GPU KERNEL\
    // Each GPU thread computes ONE element of output matrix C\
    // ======================================================\
    __global__ void matmul_gpu(int *a, int *b, int *c, int n) \{\
\
     // Compute the global row & col position for this GPU thread\
     int row = blockIdx.y * blockDim.y + threadIdx.y;\
     int col = blockIdx.x * blockDim.x + threadIdx.x;\
\
     if (row < n && col < n) \{\
        int sum = 0;\
\
     for (int k = 0; k < n; k++) \{\
      sum += a[row * n + k] * b[k * n + col];\
     \}\
     // Store final result into output matrix C\
     c[row * n + col] = sum;\
\
  \} // close if statement\
\}  // close GPU kernel function.\
\
    // =============================================\
    // CPU VERSION\
    // Used for speed comparison against the GPU.\
    // ==============================================\
    void matmul_cpu(int *a, int *b, int *c, int n) \{\
\
    // Loop through the matrix rows\
    for (int row = 0; row < n; row++) \{ // loop all of the row index of c\
    for (int col = 0; col < n; col++) \{ // loop all of the column index of c\
\
    // run the sum for matrix\
    int sum = 0;\
\
    // perform matrix multiplication\
    for (int k = 0; k < n; k++) \{\
\
    sum += a[row * n + k] * b[k * n + col];\
    \}\
    // Store result into output matrix\
    c[row * n + col] = sum;\
    \}\
   \}\
 \}\
\
  int main ()  \{\
  int n = N;\
  // compute the total memory size needed\
  size_t size = n * n * sizeof(int);\
\
 // ==========================================\
 // Allocate CPU memory (host memory)\
 // ==========================================\
 int *host_a = (int*)malloc(size);  // memory alloc for input matrix A on CPU\
 int *host_b = (int*)malloc(size);  // memory alloc for input matrix B on CPU\
\
 int *host_c_gpu  = (int*)malloc(size); // lives on the host. Will store GPU's results\
 int *host_c_cpu  = (int*)malloc(size); // lives on a host will store CPU's results.\
\
 // =====================================================\
 // Fill matrices with simple values. "n*n -> row * col"\
 // MUST be done BEFORE copying to GPU, otherwise GPU\
 // gets uninitialized garbage data.\
 // =====================================================\
 for (int i = 0; i < n * n; i++)  \{\
 // matrix A filled with 1's.\
 host_a[i] = 1;\
\
  // matrix B filled with 2's.\
  host_b[i] = 2;\
 \}\
\
// ============\
// CPU TIMING\
// ============\
printf("Running Matrix Multiplication (%dx%d)...\\n", n, n);\
// start CPU timer\
clock_t cpu_start = clock();\
// Run matrix multiplication on CPU\
matmul_cpu(host_a, host_b, host_c_cpu, n);\
// stop the CPU timer\
clock_t cpu_end = clock();\
// compute total CPU time of execution\
double cpu_time = ((double)(cpu_end - cpu_start)) / CLOCKS_PER_SEC;\
printf("CPU time: %.3f seconds\\n\\n", cpu_time);\
\
 // ======================================\
 // Allocate GPU memory (device memory)\
 // ======================================\
\
  // declare input device pointers (one int* line, then 3 vars)\
  int *device_a, *device_b, *device_c;\
\
 // GPU memory allocated for all the inputs\
 cudaMalloc(&device_a, size);\
 cudaMalloc(&device_b, size);\
 cudaMalloc(&device_c, size);\
\
 // copy memory from CPU --> GPU.\
 cudaMemcpy(device_a, host_a, size, cudaMemcpyHostToDevice);\
 cudaMemcpy(device_b, host_b, size, cudaMemcpyHostToDevice);\
\
// ==========================================\
// Configure CUDA thread/block layout\
// meaning:\
// how many blocks CUDA should create\
// how many threads each block should contain.\
// ===========================================\
// 16 row  * 16 col = 256 threads per block\
 dim3 threadsPerBlock(16, 16);\
\
 // compute number of blocks needed.\
  dim3 blocks(\
  (n + 15) / 16,\
  (n + 15) / 16\
 );\
\
// ============================\
// GPU timing using CUDA events.\
// ============================\
// Create event CUDA objects\
cudaEvent_t start;  // start timing event\
cudaEvent_t stop;   // stop  timing event\
// GPU timing events\
cudaEventCreate(&start); // when GPU work starts\
cudaEventCreate(&stop);  // when GPU work stops\
\
printf("Running GPU matrix multiplication (%dx%d)...\\n", n, n);\
cudaEventRecord(start);  // start GPU timer\
\
// Start GPU Computation: n = matrix dimension\
matmul_gpu<<<blocks, threadsPerBlock>>>(device_a, device_b, device_c, n);\
\
cudaEventRecord(stop);   // stop GPU timer\
// wait until the GPU finishes\
cudaEventSynchronize(stop);\
\
// store GPU time in milliseconds\
float gpu_time_ms = 0;\
// compute elapsed GPU time\
// why the "&", because cudaEventElapsedTime needs the address of\
// gpu_time_ms, to write the computed elapsed time into it.\
cudaEventElapsedTime(&gpu_time_ms, start, stop);\
// convert the elapsed time from ms --> sec\
double gpu_time = gpu_time_ms / 1000.0;\
// print the output to 3 decimal places.\
printf("GPU time: %.3f seconds\\n\\n", gpu_time);\
\
// copy the data GPU memory ---> CPU memory\
// (must include the 4th argument: direction)\
cudaMemcpy(host_c_gpu, device_c, size, cudaMemcpyDeviceToHost);\
\
// verify correctness:\
int expected = 2 * n;\
// if the first matrix computation equals the expected value\
// AND the last matrix computation equals the expected value\
// ==> PASS, otherwise FAIL\
int correct =\
    (host_c_gpu[0] == expected &&\
     host_c_gpu[n*n - 1] == expected);\
// print verification result\
printf("Verification: %s (expected %d, got %d)\\n",\
       correct ? "PASS" : "FAIL",\
       expected,\
       host_c_gpu[0]);\
\
// ====================\
// speed comparison\
// ====================\
printf("\\n======== Speed comparison ========\\n");\
// print CPU execution time\
printf("CPU: %.3f sec\\n", cpu_time);\
// print GPU execution time\
printf("GPU: %.3f sec\\n", gpu_time);\
// Compute GPU speedup over CPU.\
printf("Speedup: %.1fx\\n", cpu_time / gpu_time);\
\
// ================\
// cleanup memory\
// ================\
// Free GPU memory\
cudaFree(device_a);\
cudaFree(device_b);\
cudaFree(device_c);\
// Free CPU memory.\
free(host_a);\
free(host_b);\
free(host_c_gpu);\
free(host_c_cpu);\
// destroy the CUDA timing events\
cudaEventDestroy(start);\
cudaEventDestroy(stop);\
return 0;\
\}}